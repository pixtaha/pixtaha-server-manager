# Names only. Real values live in Vercel project settings, never in git.

# Data: with both set, the hub reads the schema server_manager on the self-hosted Supabase
# (RPC public.sm_fleet / public.sm_server). Without them it shows the fictional sample fleet.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in (supabase/migrations/0004_hub_auth.sql). With HUB_SECRET set, every dashboard page needs
# a passkey, or password + authenticator code. Without it the login screens run on sample data.
# HUB_SECRET: 32+ random characters (encrypts TOTP secrets, signs short-lived cookies).
# HUB_ADMIN_EMAIL: the account created by the one-time invite link /login/setup?invite=<HUB_INVITE_TOKEN>.
HUB_SECRET=
HUB_ADMIN_EMAIL=
HUB_INVITE_TOKEN=
